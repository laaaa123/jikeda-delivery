<view class="home-page"><view class="map-hero"><map id="homeMap" class="home-map" latitude="{{a}}" longitude="{{b}}" markers="{{c}}" scale="{{14}}" show-location enable-traffic></map><view class="map-top"><view class="city-picker" bindtap="{{g}}"><text class="city-name">{{d}}</text><text class="city-arrow">▼</text><text wx:if="{{e}}" class="weather-text">{{f}}</text></view><button class="locate-action" bindtap="{{h}}">重新定位</button></view><view class="pickup-bubble" bindtap="{{k}}"><text class="bubble-title">{{i}}</text><text class="bubble-sub">{{j}}</text></view><view class="map-notice"><text>选择取货地址后，系统会查询附近可接单骑手</text></view></view><scroll-view class="home-content" scroll-y><view class="intro-card"><text class="intro-title">即时跑腿配送</text><text class="intro-desc">填写取货和收货地址，查看附近骑手并发起订单</text></view><view class="order-card"><view class="service-tabs"><view wx:for="{{l}}" wx:for-item="item" wx:key="b" class="{{['service-tab', item.c]}}" bindtap="{{item.d}}">{{item.a}}</view></view><view class="address-card"><view class="address-row" bindtap="{{o}}"><view class="address-badge pickup">发</view><view class="address-main"><text class="address-title">{{m}}</text><text class="address-sub">{{n}}</text></view></view><view class="address-row" bindtap="{{r}}"><view class="address-badge drop">收</view><view class="address-main"><text class="address-title">{{p}}</text><text class="address-sub">{{q}}</text></view></view></view><view class="{{['rider-strip', v]}}"><text>{{s}}</text><text>{{t}}</text></view><button class="primary-btn" bindtap="{{w}}">下一步：完善订单</button></view><view class="process-card"><text class="process-title">下单流程</text><view class="process-steps"><view class="process-step"><view class="step-icon">写</view><text>填写地址</text></view><view class="process-step"><view class="step-icon">付</view><text>确认支付</text></view><view class="process-step"><view class="step-icon">送</view><text>骑手配送</text></view></view></view></scroll-view><nut-toast u-i="c0282b44-0" bind:__l="__l"></nut-toast><nut-notify u-i="c0282b44-1" bind:__l="__l"></nut-notify></view>