page {
  background: #eef1f5;
  min-height: 100vh;
}
.home-page {
  min-height: 100vh;
  background: #eef1f5;
  color: #15171c;
}
.map-hero {
  position: relative;
  height: 390px;
  overflow: hidden;
  background: #e8f2ee;
}
.home-map {
  width: 100%;
  height: 100%;
}
.map-top {
  position: absolute;
  left: 18px;
  right: 18px;
  top: 48px;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}
.city-picker,
.locate-action {
  pointer-events: auto;
}
.city-picker {
  max-width: 230px;
  height: 38px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10px 24px rgba(35, 46, 60, 0.12);
}
.city-name {
  max-width: 92px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 18px;
  font-weight: 800;
  color: #1e242b;
}
.city-arrow {
  margin-left: 5px;
  font-size: 10px;
  color: #30343a;
}
.weather-text {
  margin-left: 10px;
  font-size: 12px;
  color: #6d7280;
}
.locate-action {
  height: 36px;
  margin: 0;
  padding: 0 12px;
  border: 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10px 24px rgba(35, 46, 60, 0.12);
  color: #20252c;
  font-size: 13px;
  font-weight: 700;
  line-height: 36px;
}
.pickup-bubble {
  position: absolute;
  left: 50%;
  top: 145px;
  z-index: 5;
  width: 170px;
  margin-left: -85px;
  padding: 12px 10px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14px 26px rgba(32, 47, 65, 0.16);
  text-align: center;
}
.pickup-bubble::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -8px;
  width: 18px;
  height: 18px;
  margin-left: -9px;
  background: rgba(255, 255, 255, 0.94);
  transform: rotate(45deg);
  border-radius: 2px;
}
.bubble-title {
  display: block;
  color: #0784e3;
  font-size: 19px;
  font-weight: 900;
  line-height: 1.2;
}
.bubble-sub {
  display: block;
  margin-top: 5px;
  color: #6c7580;
  font-size: 12px;
  font-weight: 650;
}
.map-notice {
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 76px;
  z-index: 5;
  height: 44px;
  padding: 0 14px;
  border-radius: 15px;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14px 24px rgba(26, 38, 54, 0.11);
  color: #4f6178;
  font-size: 13px;
  font-weight: 650;
}
.home-content {
  position: relative;
  z-index: 8;
  height: calc(100vh - 310px);
  margin-top: -72px;
  padding: 0 14px 26px;
  box-sizing: border-box;
}
.intro-card {
  min-height: 92px;
  padding: 18px 20px;
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(235, 250, 242, 0.98));
  box-shadow: 0 14px 36px rgba(23, 31, 44, 0.08);
}
.intro-title {
  font-size: 22px;
  font-weight: 900;
  color: #153823;
  line-height: 1;
}
.intro-desc {
  margin-top: 9px;
  font-size: 13px;
  font-weight: 650;
  color: #607067;
}
.order-card,
.process-card {
  margin-top: 12px;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 18px 45px rgba(23, 31, 44, 0.13);
}
.order-card {
  padding: 18px;
}
.service-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin-bottom: 16px;
}
.service-tab {
  position: relative;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  color: #20242b;
  font-size: 16px;
  font-weight: 850;
}
.service-tab.active::after {
  content: "";
  position: absolute;
  left: 22px;
  right: 22px;
  bottom: 0;
  height: 4px;
  border-radius: 999px;
  background: linear-gradient(90deg, #18a8ff, #ffd51f);
}
.address-card {
  position: relative;
  overflow: hidden;
  border: 1.5px solid rgba(24, 168, 255, 0.5);
  border-radius: 17px;
  background: #fff;
}
.address-card::before {
  content: "";
  position: absolute;
  left: 27px;
  top: 58px;
  bottom: 58px;
  width: 1px;
  border-left: 2px dotted #d9e2ea;
}
.address-row {
  position: relative;
  min-height: 82px;
  padding: 17px 14px 15px 56px;
  display: flex;
  align-items: center;
}
.address-row + .address-row {
  border-top: 1px solid #f0f2f5;
}
.address-badge {
  position: absolute;
  left: 14px;
  top: 23px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 14px;
  font-weight: 900;
}
.address-badge.pickup {
  background: #18a8ff;
}
.address-badge.drop {
  background: #ffb21a;
}
.address-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.address-title {
  max-width: 260px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 21px;
  font-weight: 900;
  color: #12161d;
  line-height: 1.2;
}
.address-sub {
  max-width: 260px;
  margin-top: 8px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #f05252;
  font-size: 13px;
  font-weight: 650;
}
.rider-strip {
  height: 44px;
  margin-top: 13px;
  padding: 0 13px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f3fbf6;
  color: #1c7a43;
  font-size: 12px;
  font-weight: 780;
}
.rider-strip.warning {
  color: #b56b00;
  background: #fff8e8;
}
.primary-btn {
  width: 100%;
  height: 48px;
  margin-top: 13px;
  border: 0;
  border-radius: 15px;
  background: linear-gradient(135deg, #09c76a, #04a94f);
  color: #fff;
  font-size: 16px;
  font-weight: 900;
  line-height: 48px;
  box-shadow: 0 12px 22px rgba(7, 193, 96, 0.26);
}
.process-card {
  padding: 19px 18px;
  margin-bottom: 18px;
}
.process-title {
  display: block;
  margin-bottom: 16px;
  font-size: 20px;
  font-weight: 900;
  color: #15171c;
}
.process-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}
.process-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: #68707d;
  font-size: 12px;
  font-weight: 700;
}
.step-icon {
  width: 58px;
  height: 58px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f7fb;
  color: #18a8ff;
  font-size: 25px;
  font-weight: 900;
}