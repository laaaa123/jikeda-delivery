.container.data-v-5dbf37d4 {
  padding: 20px;
  background-color: #f8f9fc;
  min-height: 100vh;
  box-sizing: border-box;
}
.top-card.data-v-5dbf37d4 {
  background: linear-gradient(135deg, #fff 0%, #f8f9ff 100%);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 8px 24px rgba(149, 157, 165, 0.1);
  position: relative;
  overflow: hidden;
}
.top-card.data-v-5dbf37d4::before {
  content: "";
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, rgba(255, 255, 255, 0.1) 25%, transparent 25%, transparent 50%, rgba(255, 255, 255, 0.1) 50%, rgba(255, 255, 255, 0.1) 75%, transparent 75%, transparent);
  background-size: 20px 20px;
  opacity: 0.5;
}
.top-card .user-info.data-v-5dbf37d4 {
  display: flex;
  justify-content: center;
  margin-bottom: 24px;
  position: relative;
}
.top-card .user-info .credit-score.data-v-5dbf37d4 {
  text-align: center;
}
.top-card .user-info .credit-score .score.data-v-5dbf37d4 {
  font-size: 36px;
  font-weight: 600;
  background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: block;
