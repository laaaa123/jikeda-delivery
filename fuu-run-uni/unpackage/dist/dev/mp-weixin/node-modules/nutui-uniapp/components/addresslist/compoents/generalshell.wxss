.nut-theme-dark .nut-address-list-swipe, .nut-theme-dark .nut-address-list-general {
  color: var(--nut-dark-color, var(--nut-white, #fff));
  background-color: var(--nut-dark-background2, #1b1b1b);
  border-bottom: 1px solid var(--nut-dark-color-gray, var(--nut-text-color, #808080));
}
.nut-theme-dark .nut-address-list-swipe__mask, .nut-theme-dark .nut-address-list-general__mask {
  background-color: var(--nut-dark-color3, rgba(232, 230, 227, 0.8));
}
.nut-theme-dark .nut-address-list-swipe__mask-copy, .nut-theme-dark .nut-address-list-general__mask-copy {
  color: var(--nut-dark-color-gray, var(--nut-text-color, #808080));
  background-color: var(--nut-dark-color, var(--nut-white, #fff));
}
.nut-address-list-swipe, .nut-address-list-general {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 76px;
  padding: 5px 10px;
  font-size: var(--nut-addresslist-font-size, 16px);
  color: var(--nut-addresslist-font-color, #333);
  background-color: var(--nut-addresslist-bg, #fff);
  border-bottom: 1px solid var(--nut-addresslist-border, #f0f0f0);
}
.nut-address-list-swipe__mask, .nut-address-list-general__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2001;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 40px;
  background-color: var(--nut-addresslist-mask-bg, rgba(0, 0, 0, 0.4));
}
.nut-address-list-swipe__mask-copy, .nut-address-list-swipe__mask-set, .nut-address-list-swipe__mask-del, .nut-address-list-general__mask-copy, .nut-address-list-general__mask-set, .nut-address-list-general__mask-del {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 55px;
  height: 55px;
  padding: 0 10px;
  font-size: 14px;
  text-align: center;
  background-color: var(--nut-white, #fff);
  border-radius: 50%;
}
.nut-address-list-swipe__mask-set, .nut-address-list-general__mask-set {
  color: var(--nut-white, #fff);
  background-color: var(--nut-addresslist-set-bg, #f5a623);
}
.nut-address-list-swipe__mask-del, .nut-address-list-general__mask-del {
  color: var(--nut-white, #fff);
  background-color: var(--nut-addresslist-del-bg, #e1251b);
}
.nut-address-list-general:last-child {
  border-bottom: none;
}
.nut-address-list .nut-swipe:last-of-type .nut-address-list-swipe {
  border-bottom: none;
}
.nut-address-list .nut-address-list__mask-bottom {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2000;
  background-color: transparent;
}