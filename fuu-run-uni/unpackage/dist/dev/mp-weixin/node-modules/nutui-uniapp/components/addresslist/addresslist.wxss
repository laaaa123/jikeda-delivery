.nut-swipe {
  display: block;
  overflow: hidden;
}
.nut-swipe__inner {
  position: relative;
  cursor: grab;
  transition: transform 0.3s cubic-bezier(0.19, 1, 0.22, 1);
}
.nut-swipe__left, .nut-swipe__right {
  position: absolute;
  top: 0;
  height: 100%;
}
.nut-swipe__left {
  left: 0;
  transform: translate3d(-100%, 0, 0);
}
.nut-swipe__right {
  right: 0;
  transform: translate3d(100%, 0, 0);
}
.nut-theme-dark .nut-address-list__bottom {
  background-color: var(--nut-dark-background2, #1b1b1b);
}
.nut-address-list {
  overflow: hidden;
}
.nut-address-list:last-child {
  padding-bottom: 84px;
}
.nut-address-list__bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  bottom: constant(safe-area-inset-bottom);
  bottom: env(safe-area-inset-bottom);
  left: 0;
  z-index: 100000;
  box-sizing: border-box;
  width: 100%;
  padding: 12px 18px 24px;
  background-color: var(--nut-addresslist-bg, #fff);
}
.nut-address-list .nut-address-list__mask-bottom {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2000;
  background-color: transparent;
}