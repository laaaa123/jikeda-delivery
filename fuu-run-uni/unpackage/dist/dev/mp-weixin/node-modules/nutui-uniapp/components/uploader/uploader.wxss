  line-height: var(--nut-button-mini-line-height, 1.2);
}
.nut-button--block {
  display: block;
  width: 100%;
}
.nut-button--disabled {
  cursor: not-allowed;
  opacity: var(--nut-button-disabled-opacity, 0.68);
}
.nut-button--loading {
  cursor: default;
