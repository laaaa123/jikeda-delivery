.nut-theme-dark .nut-uploader__upload {
  background: var(--nut-dark-background, #131313);
}
.nut-theme-dark .nut-uploader__preview-list {
  color: var(--nut-dark-color, var(--nut-white, #fff));
  background: var(--nut-dark-background2, #1b1b1b);
}
.nut-theme-dark .close {
  color: var(--nut-dark-color, var(--nut-white, #fff)) !important;
}
.nut-uploader {
  position: relative;
  display: flex;
  flex-wrap: wrap;
}
.nut-uploader__slot {
  position: relative;
}
.nut-uploader__upload {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--nut-uploader-picture-width, 100px);
  height: var(--nut-uploader-picture-height, 100px);
  background: var(--nut-uploader-background, #f7f8fa);
}
.nut-uploader__input {
  position: absolute !important;
  top: 0;
  left: 0;
  width: 100% !important;
  height: 100% !important;
  overflow: hidden;
  cursor: pointer !important;
  opacity: 0;
}
.nut-uploader__input:disabled, .nut-uploader__input.disabled {
  cursor: not-allowed !important;
}
.nut-uploader__preview {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
  margin-bottom: 10px;
  box-shadow: 0 2px 10px 0 rgba(0, 0, 0, 0.1);
}
.nut-uploader__preview__progress {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
}
.nut-uploader__preview__progress__msg {
  margin-top: 6px;
  font-size: 12px;
  color: var(--nut-white, #fff);
}
.nut-uploader__preview.list {
  width: 100%;
  margin-top: 10px;
  margin-right: 0;
  margin-bottom: 0;
}
.nut-uploader__preview-list {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 32px;
}
.nut-uploader__preview-list .nut-uploader__preview-img__file__name {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 2px 4px;
}
.nut-uploader__preview-list .nut-uploader__preview-img__file__name .file-name__tips {
  padding: 0 20px;
  margin-left: 4px;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.nut-uploader__preview-list .nut-uploader__preview-img__file__del {
  position: absolute;
  top: 6px;
  right: 6px;
}
.nut-uploader__preview-list .nut-uploader__preview-img__file__link {
  position: absolute;
  top: 8px;
  left: 6px;
}
.nut-uploader__preview-list .nut-progress {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
}
.nut-uploader__preview-list .nut-progress .nut-progress-outer {
  height: 2px !important;
}
.nut-uploader__preview-img {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--nut-uploader-picture-width, 100px);
  height: var(--nut-uploader-picture-height, 100px);
  border-radius: 6px;
}
.nut-uploader__preview-img .close {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 1;
  color: rgba(0, 0, 0, 0.6);
  transform: translate(50%, -50%);
}
.nut-uploader__preview-img .tips {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 0;
  font-size: 12px;
  color: var(--nut-white, #fff);
  text-align: center;
  background: rgba(0, 0, 0, 0.54);
  transition: height 0.3s;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.nut-uploader__preview-img__c {
  max-width: 100%;
  max-height: 100%;
  border-radius: 6px;
}
.nut-uploader__preview-img__file {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  transition: all 0.3s;
}
.nut-uploader__preview-img__file__name {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: 100%;
  height: 100%;
  padding: 10px;
  overflow: hidden;
  font-size: 12px;
  color: var(--nut-text-color, #808080);
}
.nut-uploader__preview-img__file__name.error {
  color: red !important;
}
.nut-uploader__preview-img__file__name.success {
  color: #1890ff !important;
}