@keyframes rotation {
0% {
    transform: rotate(0deg);
}
100% {
    transform: rotate(360deg);
}
}
.nut-toast {
  position: relative;
  font-family: var(--nut-font-family, PingFang SC, Microsoft YaHei, Helvetica, Hiragino Sans GB, SimSun, sans-serif);
  pointer-events: none;
}
.nut-toast-small .nut-toast-inner {
  font-size: var(--nut-font-size-small, var(--nut-font-size-1, 12px));
}
.nut-toast-small .nut-toast-title {
  font-size: calc(var(--nut-font-size-small, var(--nut-font-size-1, 12px)) + 2px);
}
.nut-toast-base .nut-toast-inner {
  font-size: var(--nut-font-size-base, var(--nut-font-size-2, 14px));
}
.nut-toast-base .nut-toast-title {
  font-size: calc(var(--nut-font-size-base, var(--nut-font-size-2, 14px)) + 2px);
}
.nut-toast-large .nut-toast-inner {
  font-size: var(--nut-font-size-large, var(--nut-font-size-3, 16px));
}
.nut-toast-large .nut-toast-title {
  font-size: calc(var(--nut-font-size-large, var(--nut-font-size-3, 16px)) + 2px);
}
.nut-toast-wrapper {
  position: fixed;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}
.nut-toast-cover .nut-toast-wrapper {
  height: 100%;
  pointer-events: auto;
  background: var(--nut-toast-cover-bg-color, rgba(0, 0, 0, 0));
}
.nut-toast-cover:not(.nut-toast-center) .nut-toast-wrapper {
  top: 0;
}
.nut-toast-cover:not(.nut-toast-center) .nut-toast-inner {
  position: absolute;
}
.nut-toast-center .nut-toast-wrapper {
  top: 50%;
  transform: translateY(-50%);
}
.nut-toast-inner {
  display: flex;
  flex-direction: column;
  min-width: 40%;
  max-width: 65%;
  padding: var(--nut-toast-inner-padding, 24px 30px);
  color: var(--nut-toast-font-color, var(--nut-white, #fff));
  word-break: break-all;
  background: var(--nut-toast-inner-bg-color, rgba(0, 0, 0, 0.8));
  border-radius: var(--nut-toast-inner-border-radius, 12px);
}
.nut-toast-loading .nut-toast-icon-wrapper {
  align-self: center;
}
.nut-toast-loading.nut-toast-loading-rotate .nut-toast-icon-wrapper {
  animation: rotation 1s linear infinite;
}
.nut-toast-icon-wrapper {
  display: flex;
  justify-content: center;
}
.nut-toast-icon-wrapper .nut-icon-loading {
  animation: none;
}
.nut-toast-icon-wrapper + .nut-toast-title, .nut-toast-icon-wrapper + .nut-toast-text {
  margin-top: 12px;
}
.nut-toast-title + .nut-toast-text {
  margin-top: 8px;
}