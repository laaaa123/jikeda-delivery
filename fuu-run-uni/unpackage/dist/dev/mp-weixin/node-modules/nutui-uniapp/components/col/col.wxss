.nut-col {
  box-sizing: border-box;
  float: left;
  word-break: break-all;
}
.nut-col-gutter:last-child {
  padding-right: 0 !important;
}
.nut-col-gutter:first-child {
  padding-left: 0 !important;
}
.nut-col-offset-1 {
  margin-left: calc((100 / 24) * 1 * 1%);
}
.nut-col-1 {
  width: calc((100 / 24) * 1 * 1%);
}
